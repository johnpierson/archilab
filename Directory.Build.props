<Project>

	<!-- Properties common to every archilab project. Per-Revit-version projects
	     set only what actually differs: TargetFramework, RootNamespace,
	     DefineConstants, and their Revit/Dynamo package versions. -->
	<PropertyGroup>
		<LangVersion>10.0</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
		<GenerateDependencyFile>false</GenerateDependencyFile>
	</PropertyGroup>

	<PropertyGroup>
		<Version>1.0.0</Version>
		<Company>archi-lab.net</Company>
		<Product>archilab</Product>
		<Authors>Konrad K Sobon</Authors>
		<Copyright>Copyright © archi-lab.net</Copyright>
	</PropertyGroup>

</Project>
